    "from strategy_config import model_params, strategy_params, indicators_params\n",
    "import logging\n",
    "\n",
    "strategy_params.update(model_params)\n",
    "\n",
    "# optimize strategies over validation set 3\n",
    "from optimization import optimize_strategies\n",
    "from visualize import compare_strategies\n",
    "\n",
    "strategy_params['indicators'] = indicators_params\n",
    "strategy_params['substract_taxes'] = False\n",
    "\n",
    "best_indicators_strategy, best_predictions_strategy, best_hybrid_strategy = optimize_strategies(strategy_params, indicators_params)\n",
    "\n",
    "from visualize import compare_strategies_evolutions\n",
    "\n",
    "results_dfs = [best_indicators_strategy.results, best_predictions_strategy.results, best_hybrid_strategy.results]\n",
    "names = [\"Indicators\", \"Predictions\", \"Hybrid\"]\n",
    "\n",
    "compare_strategies_evolutions(results_dfs, [\"Indicators\", \"Predictions\", \"Hybrid\"], set=\"val_3\", taxes=True)"
